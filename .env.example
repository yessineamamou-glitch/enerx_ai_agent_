# Copie ce fichier en .env et remplis les valeurs. Ne commite JAMAIS .env.
OPERATOR_ID=0.0.xxxxxxx
OPERATOR_KEY=
OPERATOR_KEY_TYPE=
NETWORK=testnet
HCS_TOPIC_ID=
# Optionnel : mode LLM de l'agent news (Gemini gratuit via Google AI Studio)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optionnel : 1 = l'API refuse les toits hors de la zone d'entrainement
ENERX_STRICT_RANGE=0

# --- RAG / coefficient news (tout est optionnel : sans cle, le coefficient news reste neutre = 1.0) ---
# Force le LLM du coefficient news : gemini | claude | ollama (defaut : gemini si cle, sinon claude si cle, sinon ollama)
ENERX_NEWS_LLM=
# chroma = recherche vectorielle des news dans /ask (necessite requirements-rag.txt + python -m rag.etape2_vectorisation)
ENERX_RAG_BACKEND=
# Seuil de distance cosinus du RAG vectoriel (non calibre, defaut 0.75)
RAG_MAX_DISTANCE=0.75
# LLM local gratuit (https://ollama.com) : OLLAMA_URL / OLLAMA_MODEL
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.1
